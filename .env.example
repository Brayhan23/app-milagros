PORT=3000
DB_PATH=./data/milagros.db

# En producción: carpeta local sincronizada por Google Drive Desktop (NO la API de Google Drive)
BACKUP_PATH=C:\Users\<usuario>\Google Drive\MilagrosBackups
BACKUP_RETENCION_DIAS=30

# SMTP para HU-07: enviar copia de la factura por correo (sin timbrado DIAN).
# SMTP_PASS debe ser una "contraseña de aplicación" del proveedor (ej. Gmail:
# https://myaccount.google.com/apppasswords), NUNCA la contraseña real de la cuenta.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=contraseña-de-aplicacion-de-16-caracteres
SMTP_FROM="Milagros <tu-correo@gmail.com>"