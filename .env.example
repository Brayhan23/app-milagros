PORT=3000

# Rutas relativas (recomendado): se resuelven contra la carpeta desde donde se
# lanza el programa (con iniciar.bat, esa carpeta es donde vive el .exe — ver
# instalacion.md), así que en el PC del cliente esto crea automáticamente
# C:\AppMilagros\data\milagros.db y C:\AppMilagros\logs\ sin tocar nada acá.
DB_PATH=./data/milagros.db
LOGS_PATH=./logs

# BACKUP_PATH SIEMPRE debe apuntar FUERA de la carpeta de instalación del
# programa (a propósito: si el disco o la carpeta de instalación se dañan,
# los respaldos no pueden estar en el mismo lugar que lo que se dañó). En el
# PC del cliente, la carpeta local que sincroniza Google Drive Desktop (NO la
# API de Google Drive) — reemplazá <usuario> por el usuario real de Windows:
BACKUP_PATH=C:\Users\<usuario>\Google Drive\MilagrosBackups
BACKUP_RETENCION_DIAS=30

# Umbral de espacio libre en disco (en GB) por debajo del cual el backup
# diario advierte en consola y en logs/backup.log. Se revisa tanto el disco
# de data/milagros.db como el de BACKUP_PATH.
ESPACIO_MINIMO_GB=1

# Retención del log de auditoría: los registros más viejos que esto se
# archivan (nunca se borran sin dejar copia) a la tabla auditoria_archivo,
# que queda protegida por el mismo backup diario del archivo .db completo.
AUDITORIA_RETENCION_DIAS=30

# SMTP para HU-07: enviar copia de la factura por correo (sin timbrado DIAN),
# y para la recuperación de contraseña. Usar la cuenta de correo REAL del
# negocio, no una cuenta de pruebas. SMTP_PASS debe ser una "contraseña de
# aplicación" del proveedor (ej. Gmail: https://myaccount.google.com/apppasswords),
# NUNCA la contraseña real de la cuenta de correo.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=correo-real-del-negocio@gmail.com
SMTP_PASS=contraseña-de-aplicacion-de-16-caracteres
SMTP_FROM="Milagros <correo-real-del-negocio@gmail.com>"
